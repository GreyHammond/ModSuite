# ── Required ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=

# ── Dashboard OAuth2 (optional -- needed for authenticated dashboard access) ─
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
# e.g. http://localhost:8000/auth/callback or https://yourdomain.com/auth/callback
MODSUITE_GUILD_ID=
# The guild ID to restrict dashboard access to.
DASHBOARD_ALLOWED_ROLES=
# Comma-separated role IDs that can access the dashboard

# ── API server (optional -- defaults shown) ───────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── CORS origins (optional) ──────────────────────────────────────────────────
# Localhost origins are always allowed. Add your server's public IP or domain
# here as a comma-separated list if accessing the dashboard remotely.
# e.g. http://myserver.com,http://10.0.0.5:8000
CORS_ORIGINS=

# ── Message archive (Sentinel, v4.0) ─────────────────────────────────────────
# Where archived attachments are stored on disk.
VAULT_DIR=vault
# Attachments larger than this are recorded as metadata only (default 25 MB).
VAULT_MAX_BYTES=26214400

# ── Stream alerts ────────────────────────────────────────────────────────────
# Twitch needs an app registered at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# YouTube, Kick, and Rumble need no credentials. YouTube live status is read
# from the channel's /live page, because the Data API's search endpoint costs
# 100 quota units per call against a 10,000/day limit -- one streamer polled
# every 90 seconds would exceed the daily quota roughly tenfold.

# ── Branding (optional) ──────────────────────────────────────────────────────
# White-label a deployment without touching code.
# PRODUCT_NAME=ModSuite
# ORG_NAME=Hammond Digital Studios
# FOOTER_BRAND=ModSuite · Hammond Digital Studios
# BRAND_COLOR=0xD4A843
